NEURA1_FALKORDB_HOST=localhost
NEURA1_FALKORDB_PORT=6380
# NEURA1_FALKORDB_USERNAME=
# NEURA1_FALKORDB_PASSWORD=
NEURA1_GRAPH_NAME=voltline

# OpenAI-compatible model endpoint (local DGX via vLLM/Ollama, or hosted)
# NEURA1_LLM_BASE_URL=http://dgx.local:8000/v1
# NEURA1_LLM_API_KEY=not-needed
# NEURA1_LLM_MODEL=
# NEURA1_LLM_EMBED_MODEL=nomic-embed-text
# NEURA1_DEMO_PASSCODE=          # optional: set to require a passcode for changes (unset: open demo)

# Connections: the ERP and project planner over MCP (unset: the simulated Zoho used by the demo)
# NEURA1_ERP_MCP_URL=            # a Zoho MCP server URL (Streamable HTTP)
# NEURA1_ERP_TOOLS=              # JSON map of tool names, if the server's differ
# NEURA1_ERP_SYNC_MINUTES=0      # sync on a schedule; 0 = only when someone presses Sync

# Cloud agents (OpenAI Dots, ChatGPT, Claude): also needs External AI access switched on in the app
# NEURA1_AGENT_MCP_TOKEN=        # a long random secret
# NEURA1_AGENT_VIEWER=           # a person id whose permissions the agent reads with (unset: no amounts, no leave)
# NEURA1_AGENT_ALERT_WEBHOOK=    # a Slack incoming webhook or Teams workflow URL for plan checks
